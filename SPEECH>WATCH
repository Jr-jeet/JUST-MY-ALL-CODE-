# ---------------- THINK FUNCTION ----------------
def think(question):

    question = question.replace("what is", "")
    question = question.replace("tell me about", "")
    question = question.strip()

    if question in knowledge:
        return knowledge[question]

    return "Sorry, I do not know about that topic yet."


